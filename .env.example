# AI API Keys (Get these from your respective dashboards)
MISTRAL_API_KEY=
HUGGINGFACE_API_KEY=
OPENAI_API_KEY=

# Endpoints and Models
MISTRAL_ENDPOINT=https://api.mistral.ai/v1/chat/completions
MISTRAL_MODEL=mistral-small-latest
HUGGINGFACE_ENDPOINT=https://api-inference.huggingface.co/models/mistralai/Mistral-7B-Instruct-v0.2
OPENAI_ENDPOINT=https://api.openai.com/v1/chat/completions
OPENAI_MODEL=gpt-3.5-turbo

# App Configuration
SECRET_KEY=your_dummy_secret_key_here
DEBUG=True
PORT=5000
HOST=0.0.0.0

# Database Configuration
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD_HERE@localhost:5432/medguide_db